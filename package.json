{
  "scripts": {
    "start": "node server.js",
    "audit:course": "node scripts/audit-course-content.js",
    "audit:a1": "node scripts/audit-course-content.js --chapter=a1",
    "audit:a2": "node scripts/audit-course-content.js --chapter=a2",
    "offline:manifest": "node scripts/generate-offline-visual-manifest.js",
    "test": "playwright test",
    "test:a0": "playwright test --workers=1 --grep-invert \"A1|A2|mission preview and run|mission replay rotates|mission starts with briefing|optional mission typing|speaking self-check\"",
    "test:a1:unit1": "playwright test --workers=1 --grep \"A1 Unit 1\"",
    "test:a1:unit2": "playwright test --workers=1 --grep \"A1 Unit 2\"",
    "test:a1:unit3": "playwright test --workers=1 --grep \"A1 Unit 3\"",
    "test:a1:unit4": "playwright test --workers=1 --grep \"A1 Unit 4\"",
    "test:a1:unit5": "playwright test --workers=1 --grep \"A1 Unit 5\"",
    "test:a1:unit6": "playwright test --workers=1 --grep \"A1 Unit 6\"",
    "test:a1:unit7": "playwright test --workers=1 --grep \"A1 Unit 7\"",
    "test:a1:unit8": "playwright test --workers=1 --grep \"A1 Unit 8\"",
    "test:a1:unit9": "playwright test --workers=1 --grep \"A1 Unit 9\"",
    "test:a1:completion": "playwright test --workers=1 --grep \"A1 completion\"",
    "test:a1": "playwright test --workers=1 --grep \"A1\" --grep-invert \"A1 and A2\"",
    "test:a2:unit1": "playwright test --workers=1 --grep \"A2 Unit 1\"",
    "test:a2": "playwright test --workers=1 --grep \"A2 full chapter\"",
    "accept:a2": "npm run audit:a2 && npm run test:a2",
    "accept:a1": "npm run audit:a1 && npm run test:a1",
    "test:ui": "playwright test --ui",
    "android:debug": "./gradlew :app:assembleDebug",
    "android:bundle": "./gradlew :app:bundleRelease",
    "android:sync-web": "node scripts/sync-android-web.js",
    "v2:typecheck": "node node_modules/typescript/lib/tsc.js -p tsconfig.v2.json --noEmit",
    "v2:test": "node scripts/test-v2-runtime.js",
    "v2:build-runtime": "node scripts/build-v2-runtime.js",
    "v2:build": "node scripts/build-v2.js",
    "v2:verify": "node scripts/test-v2-runtime.js && node scripts/validate-v2-catalog.js && node scripts/audit-v2-curriculum.js && node scripts/build-v2-runtime.js && node scripts/verify-v2-prototype.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^7.0.2"
  }
}
