{
  "scripts": {
    "start": "node server.js",
    "audit:course": "node scripts/audit-course-content.js",
    "offline:manifest": "node scripts/generate-offline-visual-manifest.js",
    "test": "playwright test",
    "test:a0": "playwright test --workers=1 --grep-invert \"A1|A2|mission preview and run|mission replay rotates|mission starts with briefing|optional mission typing|speaking self-check\"",
    "test:a1:unit1": "playwright test --workers=1 --grep \"A1 Unit 1\"",
    "test:a1:unit2": "playwright test --workers=1 --grep \"A1 Unit 2\"",
    "test:a1:unit3": "playwright test --workers=1 --grep \"A1 Unit 3\"",
    "test:a1:unit4": "playwright test --workers=1 --grep \"A1 Unit 4\"",
    "test:a1:unit5": "playwright test --workers=1 --grep \"A1 Unit 5\"",
    "test:a1:unit6": "playwright test --workers=1 --grep \"A1 Unit 6\"",
    "test:a1:unit7": "playwright test --workers=1 --grep \"A1 Unit 7\"",
    "test:a1:unit8": "playwright test --workers=1 --grep \"A1 Unit 8\"",
    "test:ui": "playwright test --ui",
    "android:debug": "./gradlew :app:assembleDebug",
    "android:bundle": "./gradlew :app:bundleRelease",
    "android:sync-web": "node scripts/sync-android-web.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
